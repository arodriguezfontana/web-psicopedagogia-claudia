---
const currentYear = new Date().getFullYear();
---

<footer class="bg-teal-900 text-slate-300 py-12 border-t border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8 items-center justify-between">
            
            <div>
                <a href="#" class="text-white font-bold text-lg block mb-1 hover:text-teal-400 transition-colors">
                    Lic. Claudia Fontana
                </a>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Licenciada en Psicopedagogía <br>
                    Acompañando infancias, adolescencias y prácticas profesionales.
                </p>
            </div>

            <div class="md:text-right flex flex-col md:items-end gap-2 text-sm text-slate-400">
                <p class="flex items-center gap-1.5 justify-end">
                    Quilmes, Buenos Aires <span class="text-slate-300">•</span> Modalidad presencial y online
                </p>
                <p class="text-xs text-slate-300">
                    © {currentYear} Claudia Fontana. Todos los derechos reservados.
                </p>
            </div>

        </div>
    </div>
</footer>