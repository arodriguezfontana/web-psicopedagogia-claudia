---
interface Props {
    number: string;
    label: string;
    detail: string;
}

const { number, label, detail } = Astro.props;
---

<div class="space-y-1">
    <span class="block text-3xl sm:text-4xl font-extrabold text-teal-300 tracking-tight">
        {number}
    </span>
    <span class="block font-semibold text-white text-sm sm:text-base">
        {label}
    </span>
    <span class="block text-xs text-teal-200/80">
        {detail}
    </span>
</div>