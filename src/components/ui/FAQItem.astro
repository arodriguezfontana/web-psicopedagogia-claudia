---
interface Props {
    question: string;
    answer: string;
}

const { question, answer } = Astro.props;
---

<details class="group bg-slate-50 border border-slate-200/80 rounded-2xl p-6 transition-all [&_summary::-webkit-details-marker]:hidden">
    <summary class="flex justify-between items-center cursor-pointer font-semibold text-slate-900 text-lg select-none">
        <span>{question}</span>
        <span class="ml-4 transition-transform duration-300 group-open:rotate-180 text-teal-600 font-bold text-xl">
            +
        </span>
    </summary>
    <p class="mt-4 text-slate-600 leading-relaxed pt-2 border-t border-slate-200/60">
        {answer}
    </p>
</details>