---
import Badge from './ui/Badge.astro';
import ServiceCard from './ui/ServiceCard.astro';

const whatsappFamilyUrl = "https://wa.me/54911XXXXXXXX?text=Hola%20Claudia,%20quiero%20hacer%20una%20consulta%20por%20un%20tratamiento/evaluación%20para%20mi%20hijo/a.";
const whatsappColleaguesUrl = "https://wa.me/54911XXXXXXXX?text=Hola%20Claudia,%20soy%20colega%20y%20quiero%20consultar%20por%20supervisiones%20clínicas.";

const familyItems = [
    { title: "Evaluación y Diagnóstico", description: "Detección de dificultades específicas de aprendizaje y neurodesarrollo." },
    { title: "Tratamiento Psicopedagógico", description: "Sesiones personalizadas para trabajar estrategias y confianza escolar." },
    { title: "Orientación a Padres", description: "Espacio de escucha, pautas y articulación con los colegios." }
];

const colleagueItems = [
    { title: "Supervisión Clínica", description: "Análisis detallado de procesos diagnósticos y estrategias de abordaje." },
    { title: "Asesoramiento Profesional", description: "Acompañamiento en el armado de planificaciones y devoluciones a instituciones." },
    { title: "Mirada Institucional", description: "Estrategias prácticas derivadas de la trayectoria en jardines y escuelas." }
];
---

<section id="servicios" class="py-20 lg:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
            <Badge variant="teal" class="mb-4">
                Áreas de Abordaje
            </Badge>
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-4">
                Servicios profesionales pensados para cada necesidad
            </h2>
            <p class="text-lg text-slate-600">
                Un espacio de trabajo clínico enfocado en el respeto por los tiempos de cada etapa evolutiva.
            </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 items-start">
            
            <ServiceCard 
                icon="📚"
                title="Para Pacientes y Padres"
                description="Acompañamiento integral para niños, niñas y adolescentes de 3 a 16 años, enfocado en potenciar sus recursos de aprendizaje."
                items={familyItems}
                whatsappUrl={whatsappFamilyUrl}
                buttonText="Realizar Consulta"
                variant="teal"
            />

            <ServiceCard 
                icon="🤝🏻"
                title="Para Psicopedagogas"
                description="Un espacio de intercambio profesional basado en mis 37 años de experiencia educativa y clínica en el terreno."
                items={colleagueItems}
                whatsappUrl={whatsappColleaguesUrl}
                buttonText="Coordinar Supervisión"
                variant="teal"
            />

        </div>
    </div>
</section>