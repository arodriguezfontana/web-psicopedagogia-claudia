---
const claudiaImage = "src/images/claudia-fontana.jpeg"; 
const whatsappUrl = "";
---

<section class="relative overflow-hidden py-16 lg:py-24 bg-white">
    <div class="absolute inset-0 opacity-50">
        <div class="absolute -top-40 -right-40 w-80 h-80 rounded-full bg-teal-100 blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-sky-100 blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid md:grid-cols-12 gap-12 items-center">
            
            <div class="md:col-span-7 text-center md:text-left order-2 md:order-1">
                <span class="inline-block py-1 mr-3 px-3 rounded-full bg-teal-100 text-teal-800 text-sm font-semibold mb-6">
                    Lic. en Psicopedagogía
                </span>
                
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 mb-6 leading-tight">
                    Acompaño el desarrollo y el aprendizaje de <span class="text-teal-700">niños y adolescentes.</span>
                </h1>
                
                <p class="text-lg sm:text-xl text-slate-600 mb-8 leading-relaxed max-w-2xl mx-auto md:mx-0">
                    Más de <span class="font-bold text-teal-700 bg-teal-50 px-1.5 py-0.5 rounded">37 años de experiencia</span> educativa y clínica ayudando a familias a superar desafíos del neurodesarrollo, y potenciando la práctica de colegas psicopedagogas.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                    <a 
                        href={whatsappUrl} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold shadow-lg shadow-teal-600/20 transition-all transform hover:-translate-y-0.5 text-lg"
                    >
                        Contactame por WhatsApp
                    </a>
                    <a 
                        href="#servicios" 
                        class="inline-flex items-center justify-center px-6 py-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold border border-slate-200 transition-all text-lg"
                    >
                         Conocer Servicios
                    </a>
                </div>
            </div>

            <div class="md:col-span-5 flex justify-center md:justify-end order-1 md:order-2 mb-10 md:mb-0">
                <div class="relative group">
                    <div class="absolute -inset-4 rounded-full bg-linear-to-br from-teal-100 to-white opacity-70 group-hover:scale-105 transition-transform duration-500"></div>
                    
                    <img 
                        src={claudiaImage} 
                        alt="Lic. Claudia Fontana - Psicopedagoga" 
                        width={500}
                        height={500}
                        class="relative rounded-full shadow-2xl shadow-slate-500/30 object-cover object-center w-72 h-72 sm:w-80 sm:h-80 md:w-105 md:h-105 aspect-square border-4 border-white"
                        loading="eager"
                    />
                </div>
            </div>

        </div>
    </div>
</section>