---
import Button from './ui/Button.astro';
import NavLink from './ui/NavLink.astro';

const whatsappUrl = "";
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-100 transition-all">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <a href="#" class="flex flex-col group">
            <span class="font-bold text-lg text-slate-900 tracking-tight group-hover:text-teal-700 transition-colors">Lic. Claudia Fontana</span>
            <span class="text-xs text-teal-700 font-medium tracking-wide">Psicopedagoga</span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
            <NavLink href="#sobre-mi">Sobre mí</NavLink>
            <NavLink href="#servicios">Servicios</NavLink>
            <NavLink href="#testimonios">Testimonios</NavLink>
            <NavLink href="#preguntas-frecuentes">Preguntas Frecuentes</NavLink>
        </nav>

        <div class="hidden sm:block">
            <Button 
                href={whatsappUrl} 
                variant="primary" 
                external={true}
                class="py-2.5 px-4 text-sm shadow-none"
            >
                WhatsApp
            </Button>
        </div>
    </div>
</header>